{
  "info": {
    "name": "SkillBridge Service Requests API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "requestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Create request (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"Location header set\", () => pm.response.to.have.header(\"Location\"));",
              "pm.collectionVariables.set(\"requestId\", pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/requests",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Zinhle Dlamini\",\n  \"email\": \"zinhle@example.com\",\n  \"category\": \"opportunity\",\n  \"subject\": \"Question about a bursary\",\n  \"description\": \"Is the closing date on the listing still correct?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "List requests (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/requests",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests"
          ]
        }
      }
    },
    {
      "name": "List only open requests",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/requests?status=open",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests?status=open"
          ]
        }
      }
    },
    {
      "name": "Get one request (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/requests/{{requestId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests",
            "{{requestId}}"
          ]
        }
      }
    },
    {
      "name": "Replace request - PUT (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/requests/{{requestId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests",
            "{{requestId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Zinhle Dlamini\",\n  \"email\": \"zinhle@example.com\",\n  \"category\": \"opportunity\",\n  \"subject\": \"Updated subject\",\n  \"description\": \"Is the closing date on the listing still correct?\",\n  \"status\": \"in_progress\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Partial update - PATCH (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"status changed\", () => pm.expect(pm.response.json().data.status).to.eql(\"resolved\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/requests/{{requestId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests",
            "{{requestId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"resolved\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create with invalid data (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
              "pm.test(\"has field details\", () => pm.expect(pm.response.json().error.details.length).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/requests",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PATCH with empty body (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/requests/{{requestId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests",
            "{{requestId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Malformed id (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/requests/123",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests",
            "123"
          ]
        }
      }
    },
    {
      "name": "Unknown id (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/requests/6f1c1d5e-1b6a-4c1d-9b0e-2f2a2a2a2a2a",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests",
            "6f1c1d5e-1b6a-4c1d-9b0e-2f2a2a2a2a2a"
          ]
        }
      }
    },
    {
      "name": "Delete request (204)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/requests/{{requestId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests",
            "{{requestId}}"
          ]
        }
      }
    },
    {
      "name": "Delete again (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/requests/{{requestId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "requests",
            "{{requestId}}"
          ]
        }
      }
    }
  ]
}